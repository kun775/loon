#!name=uKids VIP 解锁
#!desc=拦截 uKids 用户接口，固定改写 VIP/SVIP 状态和到期信息
#!openUrl=
#!author=
#!icon=

[Script]
http-response ^https://prod\.ukids\.cn/uch5/getUser script-path=https://raw.githubusercontent.com/kun775/loon/refs/heads/main/ukids_vip.js, requires-body=true, timeout=10, tag=ukids_getUser
http-response ^https://fastapi\.ukids\.cn/ucapp/sync script-path=https://raw.githubusercontent.com/kun775/loon/refs/heads/main/ukids_vip.js, requires-body=true, timeout=10, tag=ukids_sync

[MITM]
hostname = prod.ukids.cn, fastapi.ukids.cn
