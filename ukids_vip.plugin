[Script]
http-response ^https://prod\.ukids\.cn/uch5/getUser script-path=https://raw.githubusercontent.com/kun775/loon/refs/heads/main/ukids_vip.js, requires-body=true, timeout=10, tag=ukids_getUser

[MITM]
hostname = prod.ukids.cn
